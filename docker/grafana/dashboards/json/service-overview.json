{
  "title": "CircleGuard - Service Overview",
  "uid": "circleguard-service-overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "rate(http_server_requests_seconds_count{application=~\"circleguard-.*\"}[5m])", "legendFormat": "{{application}}"}
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "rate(http_server_requests_seconds_count{status=~\"5..\",application=~\"circleguard-.*\"}[5m])", "legendFormat": "{{application}}"}
      ]
    }
  ]
}
