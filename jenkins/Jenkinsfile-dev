def getServiceName() {
    def jobName = env.JOB_NAME ?: 'auth'
    def parts = jobName.split('-')
    if (parts.length >= 3) {
        return parts[1]
    }
    return 'auth'
}

def getServicePort(String serviceName) {
    def ports = [
        'auth': '8180',
        'identity': '8083',
        'gateway': '8087',
        'form': '8086',
        'notification': '8082',
        'promotion': '8088'
    ]
    return ports[serviceName] ?: '8080'
}

pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io'
        SERVICE_NAME = getServiceName()
        DOCKER_IMAGE = "circleguard/${SERVICE_NAME}-service"
        DOCKER_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT[0..7]}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Building ${SERVICE_NAME} from commit ${env.GIT_COMMIT[0..7]}"
                checkout scm
            }
        }

        stage('Build & Compile') {
            steps {
                sh "./gradlew :services:circleguard-${SERVICE_NAME}-service:build -x test --no-daemon -q"
            }
        }

        stage('Unit Tests') {
            steps {
                sh "./gradlew :services:circleguard-${SERVICE_NAME}-service:test --no-daemon -q || true"
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build -f docker/Dockerfile.${SERVICE_NAME}-service \
                        -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                        -t ${DOCKER_IMAGE}:latest .
                """
            }
        }

        stage('Push to Registry') {
            when {
                anyOf { branch 'master' }
            }
            steps {
                sh """
                    docker login -u ${env.DOCKER_USERNAME} -p ${env.DOCKER_PASSWORD} || true
                    docker push ${DOCKER_IMAGE}:${DOCKER_TAG} || true
                    docker push ${DOCKER_IMAGE}:latest || true
                """
            }
        }

        stage('Deploy to Dev K8s') {
            when {
                anyOf { branch 'master'; branch 'develop' }
            }
            steps {
                sh """
                    kubectl config use-context docker-desktop || true
                    kubectl apply -f k8s/namespaces/ 2>/dev/null || true
                    kubectl apply -f k8s/dev/ 2>/dev/null || true
                    kubectl rollout status deployment/${SERVICE_NAME}-service -n circleguard-dev --timeout=60s || true
                """
            }
        }
    }

    post {
        success {
            echo "Pipeline ${SERVICE_NAME} completed successfully!"
        }
        failure {
            echo "Pipeline ${SERVICE_NAME} failed!"
        }
        always {
            cleanWs()
        }
    }
}