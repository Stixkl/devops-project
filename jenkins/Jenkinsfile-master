def getServiceName() {
    def jobName = env.JOB_NAME ?: 'auth'
    def parts = jobName.split('-')
    if (parts.length >= 3) {
        return parts[1]
    }
    return 'auth'
}

pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io'
        SERVICE_NAME = getServiceName()
        DOCKER_IMAGE = "circleguard/${SERVICE_NAME}-service"
        RELEASE_VERSION = ''
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '50'))
        disableConcurrentBuilds()
        timeout(time: 2, unit: 'HOURS')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.RELEASE_VERSION = getNextVersion()
                }
            }
        }

        stage('Build') {
            steps {
                sh "./gradlew :services:circleguard-\${SERVICE_NAME}-service:clean :services:circleguard-\${SERVICE_NAME}-service:build -x test --no-daemon"
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build -f docker/Dockerfile.\${SERVICE_NAME}-service \
                        -t \${DOCKER_IMAGE}:\${RELEASE_VERSION} \
                        -t \${DOCKER_IMAGE}:latest .
                """
            }
        }

        stage('Security Scan') {
            steps {
                sh './gradlew dependencyCheckAnalyze --no-daemon || true'
            }
        }

        stage('Push to Registry') {
            steps {
                sh """
                    docker login -u \${DOCKER_USERNAME} -p \${DOCKER_PASSWORD} || true
                    docker push \${DOCKER_IMAGE}:\${RELEASE_VERSION} || true
                    docker push \${DOCKER_IMAGE}:latest || true
                """
            }
        }

        stage('Deploy to Production K8s') {
            environment {
                DB_PASSWORD = credentials('prod-db-password')
                DB_URL = credentials('prod-db-url')
                JWT_SECRET = credentials('prod-jwt-secret')
                QR_SECRET = credentials('prod-qr-secret')
                VAULT_SECRET = credentials('prod-vault-secret')
                TWILIO_ACCOUNT_SID = credentials('prod-twilio-sid')
                TWILIO_AUTH_TOKEN = credentials('prod-twilio-token')
                GOTIFY_TOKEN = credentials('prod-gotify-token')
            }
            steps {
                sh """
                    kubectl config use-context docker-desktop || true
                    kubectl apply -f k8s/namespaces/ -n circleguard-master 2>/dev/null || true
                    # Substituir placeholders en configmaps y secrets antes de aplicar
                    envsubst < k8s/master/configmaps.yaml | kubectl apply -f - -n circleguard-master || true
                    envsubst < k8s/master/secrets.yaml | kubectl apply -f - -n circleguard-master || true
                    kubectl apply -f k8s/master/ 2>/dev/null || true
                    kubectl set image deployment/\${SERVICE_NAME}-service \
                        \${SERVICE_NAME}-service=\${DOCKER_IMAGE}:\${RELEASE_VERSION} \
                        -n circleguard-master 2>/dev/null || true
                    kubectl annotate deployment/\${SERVICE_NAME}-service \
                        kubernetes.io/change-cause="Release \${RELEASE_VERSION}" \
                        -n circleguard-master 2>/dev/null || true
                    kubectl rollout status deployment/\${SERVICE_NAME}-service -n circleguard-master --timeout=300s || true
                """
            }
        }

        stage('Smoke Tests') {
            steps {
                sh """
                    sleep 30
                    curl -sf http://localhost:8087/actuator/health || true
                """
            }
        }

        stage('Generate Release Notes') {
            steps {
                sh """
                    chmod +x scripts/generate-release-notes.sh
                    ./scripts/generate-release-notes.sh \${RELEASE_VERSION} || true
                """
            }
            post {
                success {
                    archiveArtifacts artifacts: 'RELEASE_NOTES.md', allowEmptyArchive: true, fingerprint: true
                }
            }
        }

        stage('Tag & Notify') {
            steps {
                sh """
                    git config user.email "jenkins@circleguard.com" || true
                    git config user.name "Jenkins" || true
                    git tag -a v\${RELEASE_VERSION} -m "Release \${RELEASE_VERSION}" || true
                    git push origin v\${RELEASE_VERSION} || true
                """
            }
            post {
                success {
                    echo "Release \${RELEASE_VERSION} deployed to production!"
                }
            }
        }
    }

    post {
        failure {
            // Notificacion automatica de fallos en produccion (rubrica CI/CD)
            mail to: 'devops-team@circleguard.edu,oncall@circleguard.edu',
                 subject: "[PROD] ${env.JOB_NAME} #${env.BUILD_NUMBER} FAILED — accion requerida",
                 body: "El despliegue a PRODUCCION fallo.

Build: ${env.BUILD_URL}
Version: ${env.RELEASE_VERSION}

Ejecutar plan de rollback: kubectl rollout undo (ver docs/CHANGE_MANAGEMENT.md)."
        }
        always {
            cleanWs()
        }
    }
}

def getNextVersion() {
    def lastTag = sh(
        script: 'git describe --tags --abbrev=0 2>/dev/null || echo "v0.0.0"',
        returnStdout: true
    ).trim()

    def (major, minor, patch) = lastTag.replace('v', '').split('\\.')
    return "v${major}.${minor}.${patch.toInteger() + 1}"
}