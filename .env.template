# ==========================================
# CircleGuard - Variables de Entorno
# Copia este archivo como .env y completa
# los valores para tu ambiente local.
# NUNCA versiones .env en el repositorio.
# ==========================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=password

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT ---
JWT_SECRET=my-super-secret-dev-key-32-chars-long-12345678
JWT_EXPIRATION_MS=3600000

# --- QR ---
QR_SECRET=my-qr-secret-key-for-dev-1234567890
QR_EXPIRATION_SECONDS=300

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# --- LDAP ---
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=dc=circleguard,dc=edu
LDAP_USER_DN_PATTERN=uid={0},ou=people
LDAP_GROUPS_BASE=ou=groups
LDAP_BIND_DN=cn=admin,dc=circleguard,dc=edu
LDAP_BIND_PASSWORD=admin

# --- Mail ---
MAIL_HOST=localhost
MAIL_PORT=25

# --- Service URLs ---
AUTH_SERVICE_URL=http://localhost:8180
IDENTITY_SERVICE_URL=http://localhost:8083
PROMOTION_SERVICE_URL=http://localhost:8088
GATEWAY_SERVICE_URL=http://localhost:8087

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=AC_MOCK_SID
TWILIO_AUTH_TOKEN=mock-token
TWILIO_FROM_NUMBER=+15550000000

# --- Push (Gotify) ---
GOTIFY_URL=http://localhost:8080
GOTIFY_TOKEN=mock-token

# --- LMS / Room Booking ---
LMS_API_URL=https://lms.university.edu/api/v1
ROOM_BOOKING_API_URL=https://facilities.university.edu/api/v1/rooms
NOTIFICATION_URL_TESTING=https://circleguard.example.com/testing
NOTIFICATION_URL_ISOLATION=https://circleguard.example.com/isolation
NOTIFICATION_URL_GUIDELINES=circleguard://guidelines

# --- Vault (Identity Service) ---
VAULT_SECRET=dev-vault-secret-change-in-prod
VAULT_SALT=deadbeef
VAULT_HASH_SALT=12345678

# --- Thresholds & Tuning ---
ENCOUNTER_WINDOW_DAYS=14
MANDATORY_FENCE_DAYS=14
AUTO_THRESHOLD_SECONDS=3600
K_ANONYMITY_THRESHOLD=5
BATCH_SIZE=2000
RECOVERED_TTL_DAYS=30
MAC_SESSION_TTL_HOURS=8
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_MS=2000
CACHE_MAX_SIZE=10000
CACHE_EXPIRE_MINUTES=5
GRAPH_RETENTION_DAYS=14

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# --- File Upload ---
FILE_UPLOAD_DIR=uploads
